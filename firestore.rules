rules_version = '2';

// All reads/writes go through the Firebase Admin SDK on the server
// (src/lib/firebase/admin.ts), which bypasses these rules entirely.
// Deny every direct client request as a backstop.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
